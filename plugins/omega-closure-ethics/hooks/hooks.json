{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_tool_use.py\"",
            "commandWindows": "powershell -NoProfile -Command \"py -3 \\\"$env:PLUGIN_ROOT/hooks/pre_tool_use.py\\\"\"",
            "timeout": 10,
            "statusMessage": "Omega Closure Ethics: reviewing action"
          }
        ]
      }
    ]
  }
}
